    K2["Server memory<br/>the key and its derived<br/>keys, for one approved<br/>request only"]
    K3["Attested worker<br/>in memory for the length<br/>of its lease, if the user<br/>unlocks one"]
    K1 ~~~ K2 ~~~ K3
  end
